% INPUT
% nbchan: number of channels
% trials: number of trials/segments
% srate: sampling rate
% trialsec: length of each trial (sec)
% sinum: number of unique frex sine waves
% noise: coefficient for noise into the signal
% seed: set seed number
%
% OUPUT (Structure):
% nbchan: number of channels
% trials: number of trials/segments
% pnts: time points in a trial/segment
% srate: sampling rate
% xmin: min length of a trial
% xmax: max length of a trial (sec)
% fullxmax: max length of the whole recording (sec)
% data: new created signal
% amp: a vector of amplitudes
% frex: a vector of frequ
%
% Example:
% fft_info = fftx_info = fftx2(signal, srate);


function [newsignalinfo] = creatSig2(nbchan, trials ,srate, trialsec, sinnum, noise, seed)

    % Set seed for reproducibility
    rng(seed);

    % Setting parameters
    %Create two variables to keep track of chosen Amp and Freq
    ampl = randsample(1:15, sinnum, true); % with replacement
    frex = randsample(3:0.5:40, sinnum);% without replacement

    % Time vector
    time = 0:1/srate:trialsec-(1/srate);
    pnts = length(time); % redundant but its okay
    
    % Initialize 3D signal matrix: 1 x timepoints x trials
    newsignal = zeros(nbchan, pnts, trials);

    % loop through channels
    for chani = 1:nbchan
        % Loop through trials
        for triali = 1:trials
            
            % Generate signal
            signal = zeros(1, pnts);
            for fi = 1:length(frex)
                signal = signal + ampl(fi) * sin(2 * pi * frex(fi) * time);
            end
            
            % Add unique noise for each trial
            signal = signal + noise^2*randn(size(signal));
    
            % Store in 3D matrix (1 x timepoints x trials)
            newsignal(chani, :, triali) = signal;
        end

    end

    % Sort frequencies smallest to largers and corresponding amplitudes
    [sortfrex, sortindx] = sort(frex);
    sortampl = ampl(sortindx);

    % Store signal information
    newsignalinfo = struct(); 
    newsignalinfo.nbchan = nbchan;
    newsignalinfo.trials = trials;
    newsignalinfo.pnts = pnts;
    newsignalinfo.srate = srate;
    newsignalinfo.xmin = 0;
    newsignalinfo.xmax = pnts / srate;
    newsignalinfo.fullxmax = trials * pnts / srate;
    newsignalinfo.data = newsignal;
    newsignalinfo.amp = floor(sortampl); 
    newsignalinfo.frex = floor(sortfrex);


end

